---
import ProductCard from '@components/ProductCard.astro';
import Newsletter from '@components/Newsletter.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { categories } from '@data/categories';
import { posts } from '@data/posts';
import { products } from '@data/products';

const featuredProducts = products.slice(0, 3);
---

<BaseLayout
  title="KIVO | Specialty Coffee Roastery"
  description="KIVO to specialty coffee roastery z jasnymi kawami do filtra, ziarnami pod espresso i elastycznymi profilami omniroast do domu."
>
  <section class="hero hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Specialty coffee roastery</p>
      <h1>Swiezo palona kawa bez zadecia.</h1>
      <p class="lede">KIVO pali jasne, wyraziste ziarna speciality do filtra, espresso i domowych metod. Kazda paczka ma konkretny profil smaku, pochodzenie i prosty punkt startowy do parzenia.</p>
      <div class="button-row">
        <a class="button button-dark" href="/katalog/" data-track-click="hero">Zobacz kawy</a>
        <a class="button button-lime" href="/blog/jak-wybrac-kawe-ziarnista-do-domu/" data-track-click="hero">Jak wybrac kawe</a>
      </div>
    </div>
    <div class="hero-board" aria-label="Profile kaw KIVO">
      <div class="board-cell board-green">Filter</div>
      <div class="board-cell board-lime">01</div>
      <div class="board-cell board-terracotta">Espresso</div>
      <div class="board-cell board-paper">Omniroast</div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Kategorie</p>
      <h2>Trzy profile palenia do roznych metod</h2>
    </div>
    <div class="category-grid">
      {categories.map((category, index) => (
        <a class="category-tile" href={`/kategorie/${category.slug}/`}>
          <span>0{index + 1}</span>
          <h3>{category.name}</h3>
          <p>{category.intro}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section section-bordered">
    <div class="section-heading">
      <p class="eyebrow">Wybrane kawy</p>
      <h2>Jasne paczki, mocne profile smaku</h2>
    </div>
    <div class="product-grid">
      {featuredProducts.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Blog</p>
      <h2>Poradniki o wyborze ziaren i parzeniu</h2>
    </div>
    <div class="article-grid">
      {posts.map((post) => (
        <article class="article-card">
          <p class="eyebrow">Poradnik</p>
          <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
          <p>{post.excerpt}</p>
        </article>
      ))}
    </div>
  </section>

  <Newsletter />
</BaseLayout>
