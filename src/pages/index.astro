---
import ProductCard from '@components/ProductCard.astro';
import Newsletter from '@components/Newsletter.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { products } from '@data/products';

const productSections = [
  {
    title: 'Bestsellery',
    href: '/produkty/',
    linkLabel: 'Wszystkie produkty',
    products: products.filter((product) => product.isBestseller).slice(0, 3)
  },
  {
    title: 'Filter',
    href: '/kategorie/filter/',
    linkLabel: 'Zobacz filter',
    products: products.filter((product) => product.category === 'filter').slice(0, 3)
  },
  {
    title: 'Espresso',
    href: '/kategorie/espresso/',
    linkLabel: 'Zobacz espresso',
    products: products.filter((product) => product.category === 'espresso').slice(0, 3)
  },
  {
    title: 'Omniroast',
    href: '/kategorie/omniroast/',
    linkLabel: 'Zobacz omniroast',
    products: products.filter((product) => product.category === 'omniroast').slice(0, 3)
  }
];
const formatHeroDescriptor = (notes: string[]) =>
  notes
    .map((note, index) => (index === 0 ? `${note.charAt(0).toUpperCase()}${note.slice(1)}` : note))
    .join(', ');
const shelfProducts = products.map(({ slug, category, name, notes, imageAlt, color }) => ({
  slug,
  category,
  name,
  notes: notes.join(' / '),
  descriptor: formatHeroDescriptor(notes),
  imageAlt,
  color
}));
const initialHeroProduct = shelfProducts[0];
---

<BaseLayout
  title="KIVA | Specialty Coffee Roastery"
  description="KIVA to specialty coffee roastery z jasnymi kawami do filtra, ziarnami pod espresso i elastycznymi profilami omniroast do domu."
>
  <section class={`hero hero-grid hero-theme--${initialHeroProduct.color}`} data-hero>
    <div class="hero-copy">
      <p class="eyebrow">Specialty coffee roastery</p>
      <div class="hero-message">
        <h1 data-hero-descriptor-headline>{initialHeroProduct.descriptor}</h1>
        <a class="button button-dark hero-cta-button" href="/produkty/" data-track-click="hero" data-hero-cta-button>
          <span class="hero-cta-button-label">Zobacz kawy</span>
        </a>
      </div>
    </div>
    <div class="hero-product-panel">
      <a
        class="hero-featured-product"
        href={`/produkty/${initialHeroProduct.slug}/`}
        data-hero-product-card
        data-products={JSON.stringify(shelfProducts)}
        data-interval="3000"
        data-product={initialHeroProduct.slug}
        aria-label={`Zobacz produkt ${initialHeroProduct.name}`}
      >
        <img src={`/products/${initialHeroProduct.slug}.webp`} alt={initialHeroProduct.imageAlt} width="960" height="1200" />
      </a>
    </div>
  </section>

  {productSections.map((section) => (
    <section class="section product-line-section" id={section.title.toLowerCase()}>
      <div class="section-heading section-heading-row">
        <div>
          <h2>{section.title}</h2>
        </div>
        <a class="section-link" href={section.href}>{section.linkLabel}</a>
      </div>
      <div class="product-grid">
        {section.products.map((product) => <ProductCard product={product} />)}
      </div>
    </section>
  ))}

  <Newsletter />

  <script is:inline>
    const setHeroCtaHoverOrigin = (event) => {
      const button = event.currentTarget;

      if (!(button instanceof HTMLElement) || !(event instanceof PointerEvent)) return;

      const rect = button.getBoundingClientRect();
      button.style.setProperty('--hover-x', `${event.clientX - rect.left}px`);
      button.style.setProperty('--hover-y', `${event.clientY - rect.top}px`);
    };

    const setHeroCtaFocusOrigin = (event) => {
      const button = event.currentTarget;

      if (!(button instanceof HTMLElement)) return;

      button.style.setProperty('--hover-x', '50%');
      button.style.setProperty('--hover-y', '50%');
    };

    const heroCta = document.querySelector('[data-hero-cta-button]');

    if (heroCta instanceof HTMLElement) {
      heroCta.addEventListener('pointerenter', setHeroCtaHoverOrigin);
      heroCta.addEventListener('pointermove', setHeroCtaHoverOrigin);
      heroCta.addEventListener('focus', setHeroCtaFocusOrigin);
    }

    const hero = document.querySelector('[data-hero]');
    const heroProduct = document.querySelector('[data-hero-product-card]');

    if (heroProduct instanceof HTMLElement) {
      const products = JSON.parse(heroProduct.dataset.products || '[]');
      const descriptorHeadline = document.querySelector('[data-hero-descriptor-headline]');
      const interval = Number(heroProduct.dataset.interval || 3000);
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let startIndex = 0;

      products.slice(1).forEach((product) => {
        const image = new Image();
        image.src = `/products/${product.slug}.webp`;
      });

      const renderHeroProduct = (nextStartIndex) => {
        const leadProduct = products[nextStartIndex % products.length];
        if (!leadProduct) return;

        if (descriptorHeadline) {
          descriptorHeadline.textContent = leadProduct.descriptor;
        }

        if (hero instanceof HTMLElement) {
          const themeClass = Array.from(hero.classList).find((className) => className.startsWith('hero-theme--'));
          if (themeClass) hero.classList.remove(themeClass);
          hero.classList.add(`hero-theme--${leadProduct.color}`);
        }

        heroProduct.setAttribute('href', `/produkty/${leadProduct.slug}/`);
        heroProduct.dataset.product = leadProduct.slug;
        heroProduct.setAttribute('aria-label', `Zobacz produkt ${leadProduct.name}`);

        const image = heroProduct.querySelector('img');

        if (image instanceof HTMLImageElement) {
          image.src = `/products/${leadProduct.slug}.webp`;
          image.alt = leadProduct.imageAlt;
        }

        if (!reduceMotion) {
          if (descriptorHeadline instanceof HTMLElement) {
            descriptorHeadline.classList.remove('is-rotating');
            void descriptorHeadline.offsetWidth;
            descriptorHeadline.classList.add('is-rotating');
          }

          heroProduct.classList.remove('is-rotating');
          void heroProduct.offsetWidth;
          heroProduct.classList.add('is-rotating');
        }
      };

      window.setInterval(() => {
        if (heroProduct.matches(':hover') || heroProduct.contains(document.activeElement)) return;
        startIndex = (startIndex + 1) % products.length;
        renderHeroProduct(startIndex);
      }, interval);
    }
  </script>
</BaseLayout>
