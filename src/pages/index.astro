---
import ProductCard from '@components/ProductCard.astro';
import Newsletter from '@components/Newsletter.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { categories } from '@data/categories';
import { posts } from '@data/posts';
import { products } from '@data/products';

const featuredProducts = products.slice(0, 3);
const shelfProducts = products.map(({ slug, category, name, notes, imageAlt, color }) => ({
  slug,
  category,
  name,
  notes: notes.join(' / '),
  imageAlt,
  color
}));
---

<BaseLayout
  title="KIVO | Specialty Coffee Roastery"
  description="KIVO to specialty coffee roastery z jasnymi kawami do filtra, ziarnami pod espresso i elastycznymi profilami omniroast do domu."
>
  <section class="hero hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Specialty coffee roastery</p>
      <h1>Świeżo palona kawa bez zadęcia.</h1>
      <p class="lede">KIVO pali jasne, wyraziste ziarna speciality do filtra, espresso i domowych metod. Każda paczka ma konkretny profil smaku, pochodzenie i prosty punkt startowy do parzenia.</p>
      <div class="button-row">
        <a class="button button-dark" href="/katalog/" data-track-click="hero">Zobacz kawy</a>
        <a class="button button-lime" href="/blog/jak-wybrac-kawe-ziarnista-do-domu/" data-track-click="hero">Jak wybrać kawę</a>
      </div>
    </div>
    <div class="hero-shelf" aria-label="Aktualne kawy KIVO" data-hero-shelf data-products={JSON.stringify(shelfProducts)} data-interval="5000">
      {featuredProducts.map((product, index) => (
        <a class={`hero-pack hero-pack--${product.color} hero-pack--${index + 1}`} href={`/produkty/${product.slug}/`} data-product={product.slug}>
          <img src={`/products/${product.slug}.webp`} alt={product.imageAlt} width="960" height="1200" />
          <span class="hero-pack-copy">
            <span>{product.category}</span>
            <strong>{product.name}</strong>
            <small>{product.notes.join(' / ')}</small>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Kategorie</p>
      <h2>Trzy profile palenia do różnych metod</h2>
    </div>
    <div class="category-grid">
      {categories.map((category, index) => (
        <a class="category-tile" href={`/kategorie/${category.slug}/`}>
          <span>0{index + 1}</span>
          <h3>{category.name}</h3>
          <p>{category.intro}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section section-bordered">
    <div class="section-heading">
      <p class="eyebrow">Wybrane kawy</p>
      <h2>Jasne paczki, mocne profile smaku</h2>
    </div>
    <div class="product-grid">
      {featuredProducts.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Blog</p>
      <h2>Poradniki o wyborze ziaren i parzeniu</h2>
    </div>
    <div class="article-grid">
      {posts.map((post) => (
        <article class="article-card">
          <p class="eyebrow">Poradnik</p>
          <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
          <p>{post.excerpt}</p>
        </article>
      ))}
    </div>
  </section>

  <Newsletter />

  <script is:inline>
    const shelf = document.querySelector('[data-hero-shelf]');

    if (shelf instanceof HTMLElement) {
      const products = JSON.parse(shelf.dataset.products || '[]');
      const cards = Array.from(shelf.querySelectorAll('.hero-pack'));
      const visibleCount = cards.length;
      const interval = Number(shelf.dataset.interval || 5000);
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let startIndex = 0;

      products.slice(visibleCount).forEach((product) => {
        const image = new Image();
        image.src = `/products/${product.slug}.webp`;
      });

      const renderShelfGroup = (nextStartIndex) => {
        cards.forEach((card, cardIndex) => {
          const product = products[(nextStartIndex + cardIndex) % products.length];
          if (!product) return;

          const colorClass = Array.from(card.classList).find((className) =>
            className.startsWith('hero-pack--') && !/^hero-pack--\d+$/.test(className)
          );

          if (colorClass) card.classList.remove(colorClass);
          card.classList.add(`hero-pack--${product.color}`);
          card.setAttribute('href', `/produkty/${product.slug}/`);
          card.dataset.product = product.slug;

          const image = card.querySelector('img');
          const category = card.querySelector('.hero-pack-copy > span');
          const title = card.querySelector('strong');
          const notes = card.querySelector('small');

          if (image instanceof HTMLImageElement) {
            image.src = `/products/${product.slug}.webp`;
            image.alt = product.imageAlt;
          }

          if (category) category.textContent = product.category;
          if (title) title.textContent = product.name;
          if (notes) notes.textContent = product.notes;
        });

        if (!reduceMotion) {
          shelf.classList.remove('is-rotating');
          void shelf.offsetWidth;
          shelf.classList.add('is-rotating');
        }
      };

      window.setInterval(() => {
        if (shelf.matches(':hover') || shelf.contains(document.activeElement)) return;
        startIndex = (startIndex + visibleCount) % products.length;
        renderShelfGroup(startIndex);
      }, interval);
    }
  </script>
</BaseLayout>
