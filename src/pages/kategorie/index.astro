---
import BaseLayout from '@layouts/BaseLayout.astro';
import { categories } from '@data/categories';
---

<BaseLayout
  title="Kategorie kaw KIVO: filter, espresso i omniroast"
  description="Poznaj kategorie kaw KIVO: jasno palone ziarna do filtra, kawy pod espresso i elastyczne profile omniroast."
>
  <section class="page-hero">
    <p class="eyebrow">Kategorie KIVO</p>
    <h1>Kawy podzielone według metody parzenia.</h1>
    <p class="lede">Wybierz profil do V60, ekspresu, kawiarki albo jednej paczki parzonej na kilka sposobów.</p>
  </section>

  <section class="section">
    <div class="category-grid">
      {categories.map((category, index) => (
        <a class="category-tile" href={`/kategorie/${category.slug}/`}>
          <span>0{index + 1}</span>
          <h2>{category.name}</h2>
          <p>{category.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
