---
import CategoryDescription from '@components/CategoryDescription.astro';
import ProductCatalog from '@components/ProductCatalog.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { categories } from '@data/categories';
import { products } from '@data/products';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      categoryProducts: products.filter((product) => product.category === category.slug)
    }
  }));
}

const { category, categoryProducts } = Astro.props;
const categoryHeadingTitles: Record<string, string> = {
  filter: 'Kawa do filtra',
  espresso: 'Kawa do espresso',
  omniroast: 'Kawa omniroast'
};
const categoryHeadingTitle = categoryHeadingTitles[category.slug] ?? category.name;
---

<BaseLayout
  title={category.title}
  description={category.description}
  breadcrumbs={[
    { label: 'Strona główna', href: '/' },
    { label: 'Wszystkie produkty', href: '/produkty/' },
    { label: categoryHeadingTitle }
  ]}
>
  <ProductCatalog
    items={categoryProducts}
    title={category.name}
    headingTitle={categoryHeadingTitle}
    headingIntro={category.intro}
    headingDetail={category.description}
    currentProfile={category.slug}
    ariaLabel={`Produkty w kategorii ${category.name}`}
  />
  <CategoryDescription category={category} />
</BaseLayout>
