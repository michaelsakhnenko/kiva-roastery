---
import ProductCard from '@components/ProductCard.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { categories } from '@data/categories';
import { products } from '@data/products';

const profileOptions = [
  { href: '/produkty/', label: 'Wszystkie' },
  ...categories.map((category) => ({
    href: `/kategorie/${category.slug}/`,
    label: category.slug.charAt(0).toUpperCase() + category.slug.slice(1)
  }))
];

const countries = [...new Set(products.map((product) => product.country))].sort((a, b) => a.localeCompare(b, 'pl'));
const processes = [...new Set(products.map((product) => product.process))].sort((a, b) => a.localeCompare(b, 'pl'));
const priceMin = Math.min(...products.map((product) => product.priceValue));
const priceMax = Math.max(...products.map((product) => product.priceValue));
const sensoryProfiles = [
  ['owocowy', 'Owocowy'],
  ['cytrusowy', 'Cytrusowy'],
  ['herbaciany', 'Herbaciany'],
  ['karmelowy', 'Karmelowy'],
  ['jagodowy', 'Jagodowy']
] as const;
---

<BaseLayout
  title="Wszystkie produkty | KIVA Specialty Coffee Roastery"
  description="Wszystkie produkty KIVA: świeżo palona kawa ziarnista speciality do filtra, espresso i omniroast z filtrowaniem po profilu, kraju, procesie i profilu sensorycznym."
>
  <section class="products-layout" aria-label="Lista produktów">
    <h1 class="sr-only">Wszystkie produkty</h1>
    <div class="products-main">
      <div class="products-toolbar">
        <button
          class="catalog-filter-toggle"
          type="button"
          aria-controls="product-filters"
          aria-expanded="false"
          data-filter-drawer-toggle
        >
          <span data-filter-toggle-label>Pokaż filtry +</span>
        </button>
        <p>Wyświetlono <span data-catalog-count>{products.length} z {products.length} produktów</span></p>
        <label>
          <span>Sortuj wg:</span>
          <span class="products-sort-select">
            <select data-catalog-sort>
              <option value="latest">Najnowsze</option>
              <option value="price-asc">Cena rosnąco</option>
              <option value="price-desc">Cena malejąco</option>
            </select>
          </span>
        </label>
      </div>
      <aside class="filters-panel" id="product-filters" aria-label="Filtry produktów" data-filter-drawer>
        <div class="filter-drawer-header">
          <h2>Filtry</h2>
          <button class="filter-drawer-close" type="button" aria-label="Zamknij filtry" data-filter-drawer-close>
            Zamknij
          </button>
        </div>
        <form class="filters-form" data-catalog-filters>
          <div class="filter-group">
            <h3>Cena</h3>
            <fieldset class="price-filter-fields">
              <legend class="sr-only">Cena</legend>
              <label class="price-filter-field">
                <span>Od</span>
                <input
                  type="number"
                  name="priceMin"
                  min={priceMin}
                  max={priceMax}
                  step="1"
                  placeholder={`${priceMin} zł`}
                  inputmode="numeric"
                  data-filter-price-min
                />
              </label>
              <label class="price-filter-field">
                <span>Do</span>
                <input
                  type="number"
                  name="priceMax"
                  min={priceMin}
                  max={priceMax}
                  step="1"
                  placeholder={`${priceMax} zł`}
                  inputmode="numeric"
                  data-filter-price-max
                />
              </label>
            </fieldset>
          </div>

          <div class="filter-group">
            <h3>Profil</h3>
            <nav class="profile-filter-links" aria-label="Profil">
              {profileOptions.map((option, index) => (
                <a href={option.href} aria-current={index === 0 ? 'page' : undefined} data-filter-profile-link>
                  {option.label}
                </a>
              ))}
            </nav>
          </div>

          <div class="filter-group">
            <h3>Kraj</h3>
            <fieldset>
              <legend class="sr-only">Kraj</legend>
              {countries.map((country) => (
                <label>
                  <input type="checkbox" name="country" value={country} data-filter-country />
                  <span>{country}</span>
                </label>
              ))}
            </fieldset>
          </div>

          <div class="filter-group">
            <h3>Proces</h3>
            <fieldset>
              <legend class="sr-only">Proces</legend>
              {processes.map((process) => (
                <label>
                  <input type="checkbox" name="process" value={process} data-filter-process />
                  <span>{process}</span>
                </label>
              ))}
            </fieldset>
          </div>

          <div class="filter-group">
            <h3>Profil sensoryczny</h3>
            <fieldset>
              <legend class="sr-only">Profil sensoryczny</legend>
              {sensoryProfiles.map(([value, label]) => (
                <label>
                  <input type="checkbox" name="sensory" value={value} data-filter-sensory />
                  <span>{label}</span>
                </label>
              ))}
            </fieldset>
          </div>

          <div class="filter-actions">
            <button class="button filter-apply" type="button" data-filter-drawer-close>Zastosuj</button>
            <button class="filter-reset" type="reset">Wyczyść wszystko</button>
          </div>
        </form>
      </aside>
      <button class="filter-drawer-backdrop" type="button" aria-label="Zamknij filtry" data-filter-drawer-backdrop></button>

      <div class="product-grid products-grid" data-catalog-grid>
        {products.map((product) => <ProductCard product={product} />)}
      </div>

      <p class="empty-state" data-catalog-empty hidden>Brak kaw pasujących do wybranych filtrów.</p>
    </div>
  </section>

  <script is:inline>
    const filterForm = document.querySelector('[data-catalog-filters]');
    const grid = document.querySelector('[data-catalog-grid]');
    const sortSelect = document.querySelector('[data-catalog-sort]');
    const count = document.querySelector('[data-catalog-count]');
    const empty = document.querySelector('[data-catalog-empty]');
    const filterDrawer = document.querySelector('[data-filter-drawer]');
    const filterToggle = document.querySelector('[data-filter-drawer-toggle]');
    const filterToggleLabel = document.querySelector('[data-filter-toggle-label]');
    const filterCloseControls = document.querySelectorAll('[data-filter-drawer-close], [data-filter-drawer-backdrop]');
    const drawerMedia = window.matchMedia('(min-width: 1024px)');

    const setFilterDrawerOpen = (open) => {
      if (!(filterDrawer instanceof HTMLElement)) return;

      filterDrawer.classList.toggle('is-filter-drawer-open', open);

      if (filterToggle instanceof HTMLButtonElement) {
        filterToggle.setAttribute('aria-expanded', String(open));
      }

      if (filterToggleLabel) {
        filterToggleLabel.textContent = open ? 'Ukryj filtry -' : 'Pokaż filtry +';
      }

      filterDrawer.inert = !open;
      document.documentElement.classList.toggle('has-filter-drawer-open', open && !drawerMedia.matches);
    };

    const syncFilterDrawerMode = () => {
      if (!(filterDrawer instanceof HTMLElement)) return;

      if (drawerMedia.matches) {
        setFilterDrawerOpen(false);
      } else {
        filterDrawer.inert = !filterDrawer.classList.contains('is-filter-drawer-open');
      }
    };

    if (filterToggle instanceof HTMLButtonElement && filterDrawer instanceof HTMLElement) {
      filterToggle.addEventListener('click', () => {
        const isOpen = filterDrawer.classList.contains('is-filter-drawer-open');
        filterDrawer.inert = false;
        setFilterDrawerOpen(!isOpen);
      });

      filterCloseControls.forEach((control) => {
        control.addEventListener('click', () => {
          setFilterDrawerOpen(false);
          if (!drawerMedia.matches) filterDrawer.inert = true;
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !filterDrawer.classList.contains('is-filter-drawer-open')) return;

        setFilterDrawerOpen(false);
        if (!drawerMedia.matches) filterDrawer.inert = true;
        filterToggle.focus();
      });

      document.addEventListener('pointerdown', (event) => {
        if (!filterDrawer.classList.contains('is-filter-drawer-open')) return;

        const target = event.target;
        if (!(target instanceof Node)) return;
        if (filterDrawer.contains(target) || filterToggle.contains(target)) return;

        setFilterDrawerOpen(false);
        if (!drawerMedia.matches) filterDrawer.inert = true;
      });

      drawerMedia.addEventListener('change', syncFilterDrawerMode);
      syncFilterDrawerMode();
    }

    if (filterForm instanceof HTMLFormElement && grid instanceof HTMLElement && sortSelect instanceof HTMLSelectElement) {
      const cards = Array.from(grid.querySelectorAll('[data-product-card]'));

      const sensoryProfileByNote = {
        'bergamotka': ['cytrusowy'],
        'brzoskwinia': ['owocowy'],
        'biała herbata': ['herbaciany'],
        'czarna porzeczka': ['owocowy', 'jagodowy'],
        'grejpfrut': ['cytrusowy'],
        'cukier trzcinowy': ['karmelowy'],
        'limonka': ['cytrusowy'],
        'zielone jabłko': ['owocowy'],
        'miód': ['karmelowy'],
        'czekolada': ['karmelowy'],
        'orzech laskowy': ['karmelowy'],
        'karmel': ['karmelowy'],
        'kakao': ['karmelowy'],
        'śliwka': ['owocowy'],
        'migdał': ['karmelowy'],
        'czekolada deserowa': ['karmelowy'],
        'wiśnia': ['owocowy', 'jagodowy'],
        'melasa': ['karmelowy'],
        'czerwona herbata': ['herbaciany'],
        'morela': ['owocowy'],
        'miód lipowy': ['karmelowy'],
        'pomarańcza': ['cytrusowy'],
        'czekolada mleczna': ['karmelowy'],
        'daktyl': ['owocowy'],
        'wanilia': ['karmelowy'],
        'czerwone jabłko': ['owocowy']
      };

      const sensoryProfilesForNotes = (notes) =>
        [...new Set(notes.flatMap((note) => sensoryProfileByNote[note] || []))];

      const selectedValues = (name) =>
        Array.from(filterForm.querySelectorAll(`input[name="${name}"]:checked`)).map((input) => input.value);

      const selectedPriceRange = () => {
        const minInput = filterForm.querySelector('[data-filter-price-min]');
        const maxInput = filterForm.querySelector('[data-filter-price-max]');
        const min = minInput instanceof HTMLInputElement && minInput.value ? Number(minInput.value) : -Infinity;
        const max = maxInput instanceof HTMLInputElement && maxInput.value ? Number(maxInput.value) : Infinity;

        return {
          min: Number.isFinite(min) ? min : -Infinity,
          max: Number.isFinite(max) ? max : Infinity
        };
      };

      const matchesFilters = (card) => {
        const price = Number(card.dataset.price || 0);
        const priceRange = selectedPriceRange();
        const countries = selectedValues('country');
        const processes = selectedValues('process');
        const sensory = selectedValues('sensory');
        const cardNotes = (card.dataset.notes || '').split('|');
        const cardSensoryProfiles = sensoryProfilesForNotes(cardNotes);

        return (
          price >= priceRange.min &&
          price <= priceRange.max &&
          (countries.length === 0 || countries.includes(card.dataset.country || '')) &&
          (processes.length === 0 || processes.includes(card.dataset.process || '')) &&
          (sensory.length === 0 || sensory.some((profile) => cardSensoryProfiles.includes(profile)))
        );
      };

      const sortCards = (visibleCards) => {
        const mode = sortSelect.value;
        const ordered = [...visibleCards];

        if (mode === 'price-asc') {
          ordered.sort((a, b) => Number(a.dataset.price || 0) - Number(b.dataset.price || 0));
        }

        if (mode === 'price-desc') {
          ordered.sort((a, b) => Number(b.dataset.price || 0) - Number(a.dataset.price || 0));
        }

        ordered.forEach((card) => grid.append(card));
      };

      const updateCatalog = () => {
        const visibleCards = cards.filter((card) => matchesFilters(card));

        cards.forEach((card) => {
          card.hidden = !visibleCards.includes(card);
        });

        sortCards(visibleCards);

        if (count) count.textContent = `${visibleCards.length} z ${cards.length} ${cards.length === 1 ? 'produktu' : 'produktów'}`;
        if (empty) empty.hidden = visibleCards.length > 0;
      };

      filterForm.addEventListener('change', updateCatalog);
      filterForm.addEventListener('input', updateCatalog);
      sortSelect.addEventListener('change', updateCatalog);
      ['pointerdown', 'mousedown', 'click'].forEach((eventName) => {
        sortSelect.addEventListener(eventName, (event) => event.stopPropagation());
      });
      filterForm.addEventListener('reset', () => window.setTimeout(updateCatalog, 0));

      updateCatalog();
    }
  </script>
</BaseLayout>
