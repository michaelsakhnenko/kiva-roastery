---
import BaseLayout from '@layouts/BaseLayout.astro';

const credits = await import('../../public/image-credits.json');
---

<BaseLayout
  title="Grafiki produktowe WebP | KIVA"
  description="Lista wygenerowanych grafik produktowych WebP użytych w katalogu KIVA, wraz z informacją o sposobie przygotowania."
>
  <section class="page-hero">
    <p class="eyebrow">Grafiki produktowe</p>
    <h1>Mockupy paczek kawy zapisane jako WebP z przezroczystym tłem.</h1>
    <p class="lede">Grafiki w katalogu zostały wygenerowane lokalnie dla projektu KIVA i zapisane w formacie WebP z kanałem alfa.</p>
  </section>

  <section class="section">
    <div class="credits-grid">
      {credits.default.map((item) => (
        <article class="credit-card">
          <h2>{item.title}</h2>
          <p><strong>Autor:</strong> {item.author}</p>
          <p><strong>Licencja:</strong> {item.license}</p>
          <p><strong>Źródło:</strong> {item.source}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
