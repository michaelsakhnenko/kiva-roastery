---
import BaseLayout from '@layouts/BaseLayout.astro';

const credits = await import('../../public/image-credits.json');
---

<BaseLayout
  title="Grafiki produktowe WebP | KIVO"
  description="Lista wygenerowanych grafik produktowych WebP uzytych w katalogu KIVO, wraz z informacja o sposobie przygotowania."
>
  <section class="page-hero">
    <p class="eyebrow">Grafiki produktowe</p>
    <h1>Mockupy paczek kawy zapisane jako WebP z przezroczystym tlem.</h1>
    <p class="lede">Grafiki w katalogu zostaly wygenerowane lokalnie dla projektu KIVO i zapisane w formacie WebP z kanalem alfa.</p>
  </section>

  <section class="section">
    <div class="credits-grid">
      {credits.default.map((item) => (
        <article class="credit-card">
          <h2>{item.title}</h2>
          <p><strong>Autor:</strong> {item.author}</p>
          <p><strong>Licencja:</strong> {item.license}</p>
          <p><strong>Zrodlo:</strong> {item.source}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
