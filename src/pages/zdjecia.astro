---
import BaseLayout from '@layouts/BaseLayout.astro';

const credits = await import('../../public/image-credits.json');
---

<BaseLayout
  title="Zrodla zdjec produktowych | KIVO"
  description="Lista zrodel zdjec produktowych uzytych w katalogu KIVO, wraz z autorami i licencjami."
>
  <section class="page-hero">
    <p class="eyebrow">Zrodla zdjec</p>
    <h1>Realne zdjecia produktowe z opisanymi zrodlami.</h1>
    <p class="lede">Zdjecia w katalogu zostaly zapisane lokalnie w formacie WebP i wykorzystane w celach edukacyjnych.</p>
  </section>

  <section class="section">
    <div class="credits-grid">
      {credits.default.map((item) => (
        <article class="credit-card">
          <h2>{item.title}</h2>
          <p><strong>Autor:</strong> {item.author}</p>
          <p><strong>Licencja:</strong> {item.license}</p>
          <p><strong>Zrodlo:</strong> {item.source}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
