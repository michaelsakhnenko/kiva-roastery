---
import Newsletter from '@components/Newsletter.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { posts } from '@data/posts';
---

<BaseLayout
  title="Blog KIVO: kawa speciality, ziarna i parzenie"
  description="Blog KIVO pomaga wybierac kawe ziarnista speciality, rozumiec profile palenia i parzyc lepsza kawe w domu."
>
  <section class="page-hero">
    <p class="eyebrow">Blog KIVO</p>
    <h1>Poradniki dla osob, ktore chca lepiej parzyc kawe.</h1>
    <p class="lede">Czytaj o wyborze ziaren, profilach palenia, przechowywaniu kawy i prostych decyzjach, ktore poprawiaja smak w domu.</p>
  </section>

  <section class="section">
    <div class="article-grid">
      {posts.map((post) => (
        <article class="article-card article-card-large">
          <p class="eyebrow">Poradnik</p>
          <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
          <p>{post.excerpt}</p>
        </article>
      ))}
    </div>
  </section>

  <Newsletter />
</BaseLayout>
