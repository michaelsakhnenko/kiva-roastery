---
import Newsletter from '@components/Newsletter.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { posts } from '@data/posts';
---

<BaseLayout
  title="Blog KIVO: poradniki o dekoracjach i designie"
  description="Blog KIVO pomaga wybierac designerskie lampy, nietypowe dywany i meble akcentowe do nowoczesnego mieszkania."
>
  <section class="page-hero">
    <p class="eyebrow">Blog KIVO</p>
    <h1>Poradniki dla osob, ktore lubia wyraziste wnetrza.</h1>
    <p class="lede">Czytaj o swietle, teksturze, proporcjach i dodatkach, ktore zmieniaja charakter pokoju.</p>
  </section>

  <section class="section">
    <div class="article-grid">
      {posts.map((post) => (
        <article class="article-card article-card-large">
          <p class="eyebrow">Poradnik</p>
          <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
          <p>{post.excerpt}</p>
        </article>
      ))}
    </div>
  </section>

  <Newsletter />
</BaseLayout>
