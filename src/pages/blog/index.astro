---
import Newsletter from '@components/Newsletter.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { posts } from '@data/posts';
---

<BaseLayout
  title="Blog KIVA: kawa speciality, ziarna i parzenie"
  description="Blog KIVA pomaga wybierać kawę ziarnistą speciality, rozumieć profile palenia i parzyć lepszą kawę w domu."
>
  <section class="page-hero">
    <p class="eyebrow">Blog KIVA</p>
    <h1>Poradniki dla osób, które chcą lepiej parzyć kawę.</h1>
    <p class="lede">Czytaj o wyborze ziaren, profilach palenia, przechowywaniu kawy i prostych decyzjach, które poprawiają smak w domu.</p>
  </section>

  <section class="section">
    <div class="article-grid">
      {posts.map((post) => (
        <article class="article-card article-card-large">
          <p class="eyebrow">Poradnik</p>
          <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
          <p>{post.excerpt}</p>
        </article>
      ))}
    </div>
  </section>

  <Newsletter />
</BaseLayout>
