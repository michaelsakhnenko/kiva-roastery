---
import BaseLayout from '@layouts/BaseLayout.astro';
import { posts } from '@data/posts';

const sortedPosts = [...posts].sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
const formatDate = (date: string) =>
  new Intl.DateTimeFormat('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(date));
---

<BaseLayout
  title="Blog KIVA: kawa speciality, ziarna i parzenie"
  description="Blog KIVA pomaga wybierać kawę ziarnistą speciality, rozumieć profile palenia i parzyć lepszą kawę w domu."
>
  <section class="blog-hub">
    <h1 class="sr-only">Blog KIVA: poradniki o kawie speciality</h1>

    <div class="blog-grid" aria-label="Lista poradników KIVA">
      {sortedPosts.map((post, index) => (
        <article class="blog-tile">
          <a class="blog-card-visual" href={`/blog/${post.slug}/`}>
            <img
              src={post.coverImage.src}
              alt={post.coverImage.alt}
              width="1200"
              height="900"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </a>
          <div class="blog-card-copy">
            <p class="article-kicker">{post.category}</p>
            <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
            <p>{post.excerpt}</p>
          </div>
          <div class="article-meta">
            <span>{formatDate(post.updatedAt)}</span>
            <span>{post.readingTime}</span>
          </div>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>
