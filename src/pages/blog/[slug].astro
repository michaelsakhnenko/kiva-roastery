---
import BaseLayout from '@layouts/BaseLayout.astro';
import { posts } from '@data/posts';
import { site } from '@data/site';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const formatDate = (date: string) =>
  new Intl.DateTimeFormat('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(date));
const relatedPosts = post.relatedPostSlugs
  .map((slug) => posts.find((item) => item.slug === slug))
  .filter(Boolean);
const sectionsWithImages = post.sections.map((section) => ({
  section,
  images: post.inlineImages.filter((image) => image.afterSectionId === section.id)
}));
const canonical = new URL(`/blog/${post.slug}/`, site.url).toString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt,
  articleSection: post.category,
  inLanguage: 'pl-PL',
  mainEntityOfPage: canonical,
  image: new URL(post.coverImage.src, site.url).toString(),
  author: {
    '@type': 'Organization',
    name: site.name,
    url: site.url
  },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url
  },
  keywords: post.summary.join(', ')
};
---

<BaseLayout
  title={post.metaTitle}
  description={post.description}
  breadcrumbs={[
    { label: 'Strona główna', href: '/' },
    { label: 'Blog', href: '/blog/' },
    { label: post.title }
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="article-page article-guide">
    <header class="article-guide-header">
      <figure class="article-hero-media">
        <img src={post.coverImage.src} alt={post.coverImage.alt} width="1200" height="900" decoding="async" />
      </figure>
      <div class="article-title-panel">
        <p class="eyebrow">Blog KIVA</p>
        <h1>{post.title}</h1>
        <div class="article-meta">
          <span>{post.category}</span>
          <span><time datetime={post.updatedAt}>{formatDate(post.updatedAt)}</time></span>
          <span>{post.readingTime}</span>
        </div>
      </div>
    </header>

    <div class="article-reading-layout">
      <aside class="article-rail" aria-label="Informacje o artykule">
        <span>Następny wpis</span>
        <a href={relatedPosts[0] ? `/blog/${relatedPosts[0].slug}/` : '/blog/'}>{relatedPosts[0]?.title ?? 'Blog KIVA'}</a>
      </aside>

      <div class="article-body">
        <p class="article-lede">{post.excerpt}</p>

        {sectionsWithImages.map(({ section, images }) => (
          <>
            <section id={section.id} class="article-section">
              <h2>{section.heading}</h2>
              {section.body.map((paragraph) => <p>{paragraph}</p>)}
            </section>
            {images.map((image) => (
              <figure class="article-inline-image">
                <img src={image.src} alt={image.alt} width="1200" height="900" loading="lazy" decoding="async" />
                <figcaption>{image.caption}</figcaption>
              </figure>
            ))}
          </>
        ))}
      </div>
    </div>
  </article>

</BaseLayout>
