---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="404: Nie znaleziono strony | KIVA"
  description="Strona KIVA nie została znaleziona. Wróć do kategorii, bloga lub kontaktu."
>
  <section class="page-hero error-hero">
    <p class="eyebrow">404</p>
    <h1>Ta paczka nie trafiła do palenia.</h1>
    <p class="lede">Adres nie istnieje albo został przeniesiony. Wróć do Wszystkich produktów i wybierz inną kawę.</p>
    <div class="button-row">
      <a class="button button-dark" href="/produkty/">Wszystkie produkty</a>
      <a class="button button-lime" href="/blog/">Blog</a>
      <a class="button" href="/kontakt/">Kontakt</a>
    </div>
  </section>
</BaseLayout>
