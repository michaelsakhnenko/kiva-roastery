---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="404: Nie znaleziono strony | KIVO"
  description="Strona KIVO nie zostala znaleziona. Wroc do kategorii, bloga lub kontaktu."
>
  <section class="page-hero error-hero">
    <p class="eyebrow">404</p>
    <h1>Ten obiekt zniknal z ekspozycji.</h1>
    <p class="lede">Adres nie istnieje albo zostal przeniesiony. Wroc do kolekcji KIVO i wybierz inna droge.</p>
    <div class="button-row">
      <a class="button button-dark" href="/kategorie/">Kategorie</a>
      <a class="button button-lime" href="/blog/">Blog</a>
      <a class="button" href="/kontakt/">Kontakt</a>
    </div>
  </section>
</BaseLayout>
