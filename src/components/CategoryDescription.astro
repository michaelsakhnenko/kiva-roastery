---
import type { categories } from '@data/categories';

type Category = (typeof categories)[number];

interface Props {
  category: Category;
}

const { category } = Astro.props;
const { shopDescription } = category;
---

<section class="category-description" data-category-description aria-label={`Opis kategorii ${category.name}`}>
  <p class="category-description-label">{shopDescription.label}</p>
  <div class="category-description-grid">
    {
      shopDescription.sections.map((section) => (
        <article class="category-description-item">
          <h2>{section.heading}</h2>
          <p>{section.body}</p>
        </article>
      ))
    }
  </div>
</section>
