---
import { site } from '@data/site';
---

<section class="newsletter" id="newsletter" aria-labelledby="newsletter-title">
  <div>
    <p class="eyebrow">Newsletter KIVO</p>
    <h2 id="newsletter-title">Dostawaj nowe palenia, receptury i kody na pierwsze zamowienie.</h2>
    <p>
      Formularz jest przygotowany do polaczenia z MailerLite lub Brevo, gdzie powstanie wymagana automatyzacja: email powitalny i dwie kolejne wiadomosci o wyborze kawy oraz parzeniu.
    </p>
  </div>
  <form class="newsletter-form" action={site.newsletterProviderUrl} method="post" data-track-form="newsletter">
    <label for="newsletter-email">Adres email</label>
    <div class="form-row">
      <input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="twoj@email.pl" required />
      <button type="submit">Zapisz sie</button>
    </div>
    <p class="form-help">Po podlaczeniu narzedzia automation formularz bedzie uruchamial sekwencje powitalna dla nowych subskrybentow.</p>
  </form>
</section>
