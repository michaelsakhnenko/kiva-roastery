---
const nav = [
  { href: '/produkty/', label: 'Wszystkie produkty' },
  { href: '/produkty/?sort=latest', label: 'Nowości' },
  { href: '/o-kiva/', label: 'O KIVA' },
  { href: '/blog/', label: 'Blog' },
  { href: '/kontakt/', label: 'Kontakt' }
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="KIVA strona główna">KIVA</a>
  <details class="mobile-menu">
    <summary aria-label="Otwórz menu">
      <span class="sr-only">Menu</span>
      <span class="burger-icon" aria-hidden="true"></span>
    </summary>
    <nav class="mobile-nav" aria-label="Menu mobilne">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/koszyk/" data-cart-link>Koszyk (<span data-cart-count>0</span>)</a>
    </nav>
  </details>
  <nav class="main-nav" aria-label="Główne">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <a class="nav-cta" href="/koszyk/" data-cart-link aria-label="Koszyk, obecnie pusty">Koszyk (<span data-cart-count>0</span>)</a>
  <p class="mobile-brand-strap">Specialty coffee roastery</p>
</header>
