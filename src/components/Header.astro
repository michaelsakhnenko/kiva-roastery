---
const nav = [
  { href: '/katalog/', label: 'Katalog' },
  { href: '/kategorie/filter/', label: 'Filter' },
  { href: '/kategorie/espresso/', label: 'Espresso' },
  { href: '/kategorie/omniroast/', label: 'Omniroast' },
  { href: '/blog/', label: 'Blog' },
  { href: '/kontakt/', label: 'Kontakt' }
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="KIVO strona główna">KIVO</a>
  <nav class="main-nav" aria-label="Główne">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <a class="nav-cta" href="#newsletter">Newsletter</a>
</header>
